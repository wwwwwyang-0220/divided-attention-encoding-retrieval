#Simplified Conjoint Recognition model with separate parameters
IntactFA II_FA Vi_fa+(1-Vi_fa)*Gi_fa*a_fa+(1-Vi_fa)*(1-Gi_fa)*b_fa*a_fa
IntactFA RI_FA (1-Vi_fa)*Gi_fa*(1-a_fa)+(1-Vi_fa)*(1-Gi_fa)*b_fa*(1-a_fa)
IntactFA UI_FA (1-Vi_fa)*(1-Gi_fa)*(1-b_fa)
RelatedFA IR_FA (1-Vr_fa)*Gr_fa*a_fa+(1-Vr_fa)*(1-Gr_fa)*b_fa*a_fa
RelatedFA RR_FA Vr_fa+(1-Vr_fa)*Gr_fa*(1-a_fa)+(1-Vr_fa)*(1-Gr_fa)*b_fa*(1-a_fa)
RelatedFA UR_FA (1-Vr_fa)*(1-Gr_fa)*(1-b_fa)
UnrelatdFA IU_FA b_fa*a_fa
UnrelatdFA RU_FA b_fa*(1-a_fa)
UnrelatdFA UU_FA 1-b_fa
IntactDivision II_Division Vi_division+(1-Vi_division)*Gi_division*a_division+(1-Vi_division)*(1-Gi_division)*b_division*a_division
IntactDivision RI_Division (1-Vi_division)*Gi_division*(1-a_division)+(1-Vi_division)*(1-Gi_division)*b_division*(1-a_division)
IntactDivision UI_Division (1-Vi_division)*(1-Gi_division)*(1-b_division)
RelatedDivision IR_Division (1-Vr_division)*Gr_division*a_division+(1-Vr_division)*(1-Gr_division)*b_division*a_division
RelatedDivision RR_Division Vr_division+(1-Vr_division)*Gr_division*(1-a_division)+(1-Vr_division)*(1-Gr_division)*b_division*(1-a_division)
RelatedDivision UR_Division (1-Vr_division)*(1-Gr_division)*(1-b_division)
UnrelatdDivision IU_Division b_division*a_division
UnrelatdDivision RU_Division b_division*(1-a_division)
UnrelatdDivision UU_Division 1-b_division
