####### Hierarchical latent-trait MPT with TreeBGUS #####

 data{
for(s in 1:S){
  zeros[s] <- 0
}
}

 model{

 for (n in 1: subjs){

### MPT model equations:
T_IntactAddition[n,1] <- theta[13,n]+(1-theta[13,n])*theta[7,n]*theta[1,n]+(1-theta[13,n])*(1-theta[7,n])*theta[4,n]*theta[1,n]
T_IntactAddition[n,2] <- (1-theta[13,n])*theta[7,n]*(1-theta[1,n])+(1-theta[13,n])*(1-theta[7,n])*theta[4,n]*(1-theta[1,n])
T_IntactAddition[n,3] <- (1-theta[13,n])*(1-theta[7,n])*(1-theta[4,n])

T_IntactDivision[n,1] <- theta[14,n]+(1-theta[14,n])*theta[8,n]*theta[2,n]+(1-theta[14,n])*(1-theta[8,n])*theta[5,n]*theta[2,n]
T_IntactDivision[n,2] <- (1-theta[14,n])*theta[8,n]*(1-theta[2,n])+(1-theta[14,n])*(1-theta[8,n])*theta[5,n]*(1-theta[2,n])
T_IntactDivision[n,3] <- (1-theta[14,n])*(1-theta[8,n])*(1-theta[5,n])

T_IntactFA[n,1] <- theta[15,n]+(1-theta[15,n])*theta[9,n]*theta[3,n]+(1-theta[15,n])*(1-theta[9,n])*theta[6,n]*theta[3,n]
T_IntactFA[n,2] <- (1-theta[15,n])*theta[9,n]*(1-theta[3,n])+(1-theta[15,n])*(1-theta[9,n])*theta[6,n]*(1-theta[3,n])
T_IntactFA[n,3] <- (1-theta[15,n])*(1-theta[9,n])*(1-theta[6,n])

T_RelatedAddition[n,1] <- (1-theta[16,n])*theta[10,n]*theta[1,n]+(1-theta[16,n])*(1-theta[10,n])*theta[4,n]*theta[1,n]
T_RelatedAddition[n,2] <- theta[16,n]+(1-theta[16,n])*theta[10,n]*(1-theta[1,n])+(1-theta[16,n])*(1-theta[10,n])*theta[4,n]*(1-theta[1,n])
T_RelatedAddition[n,3] <- (1-theta[16,n])*(1-theta[10,n])*(1-theta[4,n])

T_RelatedDivision[n,1] <- (1-theta[17,n])*theta[11,n]*theta[2,n]+(1-theta[17,n])*(1-theta[11,n])*theta[5,n]*theta[2,n]
T_RelatedDivision[n,2] <- theta[17,n]+(1-theta[17,n])*theta[11,n]*(1-theta[2,n])+(1-theta[17,n])*(1-theta[11,n])*theta[5,n]*(1-theta[2,n])
T_RelatedDivision[n,3] <- (1-theta[17,n])*(1-theta[11,n])*(1-theta[5,n])

T_RelatedFA[n,1] <- (1-theta[18,n])*theta[12,n]*theta[3,n]+(1-theta[18,n])*(1-theta[12,n])*theta[6,n]*theta[3,n]
T_RelatedFA[n,2] <- theta[18,n]+(1-theta[18,n])*theta[12,n]*(1-theta[3,n])+(1-theta[18,n])*(1-theta[12,n])*theta[6,n]*(1-theta[3,n])
T_RelatedFA[n,3] <- (1-theta[18,n])*(1-theta[12,n])*(1-theta[6,n])

T_UnrelatdAddition[n,1] <- theta[4,n]*theta[1,n]
T_UnrelatdAddition[n,2] <- theta[4,n]*(1-theta[1,n])
T_UnrelatdAddition[n,3] <- 1-theta[4,n]

T_UnrelatdDivision[n,1] <- theta[5,n]*theta[2,n]
T_UnrelatdDivision[n,2] <- theta[5,n]*(1-theta[2,n])
T_UnrelatdDivision[n,3] <- 1-theta[5,n]

T_UnrelatdFA[n,1] <- theta[6,n]*theta[3,n]
T_UnrelatdFA[n,2] <- theta[6,n]*(1-theta[3,n])
T_UnrelatdFA[n,3] <- 1-theta[6,n]


### Multinomial likelihood:
response.T_IntactAddition[n,1:3] ~ dmulti(T_IntactAddition[n,1:3],items.T_IntactAddition[n])
response.T_IntactDivision[n,1:3] ~ dmulti(T_IntactDivision[n,1:3],items.T_IntactDivision[n])
response.T_IntactFA[n,1:3] ~ dmulti(T_IntactFA[n,1:3],items.T_IntactFA[n])
response.T_RelatedAddition[n,1:3] ~ dmulti(T_RelatedAddition[n,1:3],items.T_RelatedAddition[n])
response.T_RelatedDivision[n,1:3] ~ dmulti(T_RelatedDivision[n,1:3],items.T_RelatedDivision[n])
response.T_RelatedFA[n,1:3] ~ dmulti(T_RelatedFA[n,1:3],items.T_RelatedFA[n])
response.T_UnrelatdAddition[n,1:3] ~ dmulti(T_UnrelatdAddition[n,1:3],items.T_UnrelatdAddition[n])
response.T_UnrelatdDivision[n,1:3] ~ dmulti(T_UnrelatdDivision[n,1:3],items.T_UnrelatdDivision[n])
response.T_UnrelatdFA[n,1:3] ~ dmulti(T_UnrelatdFA[n,1:3],items.T_UnrelatdFA[n])
}


### Hierarchical structure: 
    for(i in 1:subjs) {
      for(s in 1:S){
        theta[s,i] <- phi(mu[s] + xi[s]*delta.part.raw[s,i])
      }
    }
    

    # hyperpriors
    for(i in 1:subjs) {
      delta.part.raw[1:S,i] ~ dmnorm(zeros,T.prec.part[1:S,1:S])
    }

    
    T.prec.part[1:S,1:S] ~ dwish(V, df)
    Sigma.raw[1:S,1:S] <- inverse(T.prec.part[,])
    for(s in 1:S){
      mean[s] <- phi(mu[s])
      for(q in 1:S){
        Sigma[s,q] <- Sigma.raw[q,s]*xi[s]*xi[q]
      }
    }

    for(s in 1:S){
      for(q in 1:S){
        # Off-diagonal elements of S (correlations not affected by xi)
        rho[s,q] <- Sigma[s,q]/sqrt(Sigma[s,s]*Sigma[q,q])
      }
      # Diagonal elements of S (rescale sigma)
      sigma[s] <- sqrt(Sigma[s,s])
    }


mu[1] ~ dnorm(0,1)
mu[2] ~ dnorm(0,1)
mu[3] ~ dnorm(0,1)
mu[4] ~ dnorm(0,1)
